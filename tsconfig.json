{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "hardhat.config.ts",
    "scripts/**/*.ts",
    "ignition/**/*.ts",
    "arguments/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "artifacts", "cache", "typechain-types"]
}
